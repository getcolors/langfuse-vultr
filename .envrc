# -*- mode: sh; sh-shell: bash -*-
export DIRENV_WARN_TIMEOUT=20s
eval "$(devenv direnvrc)"
use devenv 2>/dev/null

# Safe to commit: every credential lives in the gitignored .envrc.private.
# Missing credentials must not prevent credential-free builds or safe dry runs.
# Run `direnv allow` once after the toolchain is installed.
#
# Never export COLORS_PAR_PROFILE. It identifies this deployment and must come
# only from colors.yml.
source_env_if_exists .envrc.private

# The Neon storage tier is the getcolors/neon package, rendered from a SHA pin.
# Its play reads exactly COLORS_PAR_NEON_R2_ACCESS_KEY_ID and
# COLORS_PAR_NEON_R2_SECRET_ACCESS_KEY via lookup('env', ...) at execution
# time, and ansible-playbook inherits this environment. Neon data and Langfuse
# events share the storage bucket in this deployment, so the storage pair is
# mapped across here -- non-secret plumbing in a tracked file, with the values
# living only in the gitignored .envrc.private.
#
# Supplying a dedicated COLORS_PAR_NEON_R2_* pair in .envrc.private takes
# precedence automatically; together with a distinct langfuse-s3-bucket that
# is the hardening path colors.yml describes.
: "${COLORS_PAR_NEON_R2_ACCESS_KEY_ID:=${COLORS_PAR_LANGFUSE_STORAGE_R2_ACCESS_KEY_ID:-}}"
: "${COLORS_PAR_NEON_R2_SECRET_ACCESS_KEY:=${COLORS_PAR_LANGFUSE_STORAGE_R2_SECRET_ACCESS_KEY:-}}"
export COLORS_PAR_NEON_R2_ACCESS_KEY_ID COLORS_PAR_NEON_R2_SECRET_ACCESS_KEY
